# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# uv / venv
.venv/
uv.lock.bak

# Test / lint / type-check caches
.pytest_cache/
.ruff_cache/
.ty_cache/
.coverage
htmlcov/

# Local cache used by the verifier at runtime
.cache/

# Agent / experiment scratch (never commit)
.scratch/

# Editors / OS
.vscode/
.idea/
.cursor/
.DS_Store

# Env files
.env
.env.*
!.env.example

# Per-deployment GCP values (project id, ingress range, registry path).
# Real values stay local; only site.env.example is committed.
deploy/gce/site.env

# Generated smoke records: reproducible by rerunning the smoke.
smokes/*/results.json
