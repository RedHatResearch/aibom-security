# Copy to deploy/gce/site.env and fill in. That file is git-ignored.
# Everything here is deployment specific; none of it belongs in the repo.

# GCP project that hosts the VM and the Artifact Registry repository.
PROJECT=your-gcp-project-id

# Source range allowed to reach tcp/8080: the calling cluster's node/pod
# egress range on the corporate network. Required; there is no safe default.
CLIENT_CIDR=10.0.0.0/8

# Optional overrides (defaults shown).
#REGION=us-east1
#ZONE=us-east1-b
#SUBNET_RANGE=10.42.0.0/24
#IMAGE=us-east1-docker.pkg.dev/$PROJECT/aibom/aibom-security:0.1.0
