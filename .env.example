# Required for host-side `aibom verify --backend compose` (proxy + Redis).
# Copy to `.env`, then: set -a && source .env && set +a
# Do not commit real secrets. Values match published ports (127.0.0.1) /
# local-only credentials in docker-compose.yml.
# Container services use Docker DNS (postgres/minio/redis); do not reuse
# those hostnames on the host.

AIBOM_STORE=proxy
AIBOM_PG_DSN=postgresql://aibom:aibom@localhost:5432/aibom
AIBOM_MINIO_ENDPOINT=localhost:9000
AIBOM_MINIO_ACCESS_KEY=minioadmin
AIBOM_MINIO_SECRET_KEY=minioadmin
AIBOM_MINIO_BUCKET=aibom-artifacts
AIBOM_MINIO_SECURE=0
AIBOM_REDIS_URL=redis://localhost:6379/0

# Optional telemetry (non-blocking). File tee is best-effort.
# AIBOM_LOG_FILE=
# AIBOM_RUN_ID=
